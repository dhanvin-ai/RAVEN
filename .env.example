# Copy to .env and adjust. Never commit real secrets.

APP_NAME=RAVEN
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# SQLAlchemy async URL (asyncpg)
DATABASE_URL=postgresql+asyncpg://raven:raven@localhost:5432/raven

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Request timeout / future sandbox defaults
REQUEST_ID_HEADER=X-Request-ID
